{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "nixos",
    "color": {
      "1": "magenta",
      "2": "light_yellow",
      "3": "white",
      "4": "cyan",
      "5": "magenta",
      "6": "white"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    {
      "type": "command",
      "key": "OS Age",
      "text": "echo $((($(date +%s)-$(date -d \"$(cat /etc/nixos/install-date)\" +%s))/86400)) days"
    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
