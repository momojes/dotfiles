// ---------------------------------------------------------
// MacAdorable Niri configuration
// ~/.config/niri/config.kdl
// ---------------------------------------------------------

// Ask applications to omit client-side decorations.
prefer-no-csd

// ---------------------------------------------------------
// Display
// ---------------------------------------------------------

// Confirm the output name with:
// niri msg outputs
output "eDP-1" {
    scale 1.5
}

// ---------------------------------------------------------
// Input
// ---------------------------------------------------------

input {
    keyboard {
        xkb {
            layout "us"

            // Caps Lock becomes Escape.
            options "ctrl:nocaps"
        }

        repeat-delay 300
        repeat-rate 30
    }

    touchpad {
        tap
        natural-scroll
        dwt
        click-method "clickfinger"
    }

    // Keep window focus under direct keyboard control.
    focus-follows-mouse max-scroll-amount="0%"
}

// ---------------------------------------------------------
// Startup applications
// ---------------------------------------------------------

spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "swayidle" "-w" "timeout" "300" "swaylock" "-f" "timeout" "360" "niri msg action power-off-monitors" "resume" "niri msg action power-on-monitors" "before-sleep" "swaylock" "-f"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"

// Wallpaper Setup
spawn-at-startup "swaybg" "-i" "/home/momo/pictures/wallpapers/backgroundMacAdorable.png" "-m" "fill"

// ---------------------------------------------------------
// Screenshots
// ---------------------------------------------------------

screenshot-path "~/pictures/screenshots/screenshot-%Y-%m-%d-%H-%M-%S.png"

// ---------------------------------------------------------
// Startup hotkey overlay
// ---------------------------------------------------------

hotkey-overlay {
    skip-at-startup
}

// ---------------------------------------------------------
// Overview
// ---------------------------------------------------------

overview {
    backdrop-color "#000000"
}

// ---------------------------------------------------------
// Layout and appearance
// ---------------------------------------------------------

layout {
    gaps 1

    center-focused-column "never"

    default-column-width {
        proportion 0.5
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        on
        width 1

        // Active window: green
        active-color "#00aa00"

        // Inactive windows
        inactive-color "#404040"

        // Urgent window
        urgent-color "#cc3333"
    }

    border {
        off
    }

    background-color "#000000"
}

// Keep the focus ring as a clean outline around applications.
window-rule {
    draw-border-with-background false
}

// ---------------------------------------------------------
// Keybindings
// ---------------------------------------------------------

binds {
    // -----------------------------------------------------
    // Applications
    // -----------------------------------------------------

    Mod+Return hotkey-overlay-title="Open Terminal" {
        spawn "kitty";
    }

    Mod+Space hotkey-overlay-title="Open Application Launcher" {
        spawn "fuzzel" "--anchor=top";
    }

    Mod+E hotkey-overlay-title="Open Emacs" {
        spawn "emacsclient" "-c" "-n";
    }

    Mod+Shift+E hotkey-overlay-title="Open Power Menu" {
        spawn "wlogout" "--layout" "/home/momo/.config/wlogout/layout" "--css" "/home/momo/.config/wlogout/style.css";
    }

    // -----------------------------------------------------
    // Window management
    // -----------------------------------------------------

    Mod+Q repeat=false {
        close-window;
    }

    Mod+F {
        maximize-column;
    }

    Mod+Shift+F {
        fullscreen-window;
    }

    Mod+V {
        toggle-window-floating;
    }

    Mod+C {
        center-column;
    }

    Mod+R {
        switch-preset-column-width;
    }

    Mod+Shift+R {
        reset-window-height;
    }

    // -----------------------------------------------------
    // Focus movement
    // -----------------------------------------------------

    Mod+H {
        focus-column-left;
    }

    Mod+L {
        focus-column-right;
    }

    Mod+J {
        focus-window-down;
    }

    Mod+K {
        focus-window-up;
    }

    Mod+Left {
        focus-column-left;
    }

    Mod+Right {
        focus-column-right;
    }

    Mod+Down {
        focus-window-down;
    }

    Mod+Up {
        focus-window-up;
    }

    // -----------------------------------------------------
    // Move windows
    // -----------------------------------------------------

    Mod+Shift+H {
        move-column-left;
    }

    Mod+Shift+L {
        move-column-right;
    }

    Mod+Shift+J {
        move-window-down;
    }

    Mod+Shift+K {
        move-window-up;
    }

    Mod+Shift+Left {
        move-column-left;
    }

    Mod+Shift+Right {
        move-column-right;
    }

    Mod+Shift+Down {
        move-window-down;
    }

    Mod+Shift+Up {
        move-window-up;
    }

    // -----------------------------------------------------
    // Workspaces
    // -----------------------------------------------------

    Mod+Page_Down {
        focus-workspace-down;
    }

    Mod+Page_Up {
        focus-workspace-up;
    }

    Mod+U {
        focus-workspace-down;
    }

    Mod+I {
        focus-workspace-up;
    }

    Mod+Shift+U {
        move-column-to-workspace-down;
    }

    Mod+Shift+I {
        move-column-to-workspace-up;
    }

    // -----------------------------------------------------
    // Overview
    // -----------------------------------------------------

    Mod+O repeat=false {
        toggle-overview;
    }

    // -----------------------------------------------------
    // Screenshots
    // -----------------------------------------------------

    // Interactive region/window screenshot.
    Mod+Shift+P {
        screenshot show-pointer=false;
    }

    // Screenshot the focused window.
    Alt+P {
        screenshot-window show-pointer=false;
    }

    // Screenshot the entire output.
    Mod+P {
        screenshot-screen show-pointer=false;
    }

    // -----------------------------------------------------
    // Audio
    // -----------------------------------------------------

    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+";
    }

    XF86AudioLowerVolume allow-when-locked=true {
        spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-";
    }

    XF86AudioMute allow-when-locked=true {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle";
    }

    XF86AudioMicMute allow-when-locked=true {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle";
    }

    // -----------------------------------------------------
    // Display brightness
    // -----------------------------------------------------

    XF86MonBrightnessUp allow-when-locked=true {
        spawn "brightnessctl" "set" "+5%";
    }

    XF86MonBrightnessDown allow-when-locked=true {
        spawn "brightnessctl" "set" "5%-";
    }

    // -----------------------------------------------------
    // Keyboard backlight
    // -----------------------------------------------------

    XF86KbdBrightnessUp allow-when-locked=true {
        spawn "brightnessctl" "--device=spi::kbd_backlight" "set" "+10%";
    }

    XF86KbdBrightnessDown allow-when-locked=true {
        spawn "brightnessctl" "--device=spi::kbd_backlight" "set" "10%-";
    }

    // -----------------------------------------------------
    // Media playback
    // -----------------------------------------------------

    XF86AudioPlay allow-when-locked=true {
        spawn "playerctl" "play-pause";
    }

    XF86AudioNext allow-when-locked=true {
        spawn "playerctl" "next";
    }

    XF86AudioPrev allow-when-locked=true {
        spawn "playerctl" "previous";
    }

    // -----------------------------------------------------
    // Session
    // -----------------------------------------------------

    Mod+Shift+Escape {
        quit;
    }

    // Show the hotkey overlay manually.
    Mod+Shift+Slash {
        show-hotkey-overlay;
    }

    // -----------------------------------------------------
    // Lock Screen
    // -----------------------------------------------------

    Mod+Control+L allow-when-locked=true {
        spawn "swaylock";
    }

    // -----------------------------------------------------
    // Notifications
    // -----------------------------------------------------

    Mod+Shift+N {
        spawn "makoctl" "dismiss";
    }

    // -----------------------------------------------------
    // Clipboard
    // -----------------------------------------------------

    Mod+B hotkey-overlay-title="Clipboard History" {
        spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy";
    }

    Mod+Shift+B hotkey-overlay-title="Clear Clipboard History" {
        spawn "cliphist" "wipe";
    }
}